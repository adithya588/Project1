{
  "datasets": [
    {
      "name": "716cfbca",
      "displayName": "Earthquake_detail",
      "queryLines": [
        "select * from dev_cat.silver.earthquake_data_final"
      ],
      "catalog": "dev_cat",
      "schema": "default"
    },
    {
      "name": "772eb42f",
      "displayName": "EarthQuake Type",
      "queryLines": [
        "SELECT \r\n",
        "    COUNT(*) AS total_magnitude_bucket,\r\n",
        "    magnitude_bucket\r\n",
        "FROM (\r\n",
        "    SELECT \r\n",
        "        CASE\r\n",
        "            WHEN mag < 2 THEN 'Micro (<2)'\r\n",
        "            WHEN mag >= 2 AND mag < 3 THEN 'Minor (2–3)'\r\n",
        "            WHEN mag >= 3 AND mag < 4 THEN 'Light (3–4)'\r\n",
        "            ELSE 'Moderate+ (4+)'\r\n",
        "        END AS magnitude_bucket\r\n",
        "    FROM silver.earthquake_data_final\r\n",
        ") \r\n",
        "GROUP BY magnitude_bucket;"
      ],
      "catalog": "dev_cat",
      "schema": "default"
    },
    {
      "name": "ae25e059",
      "displayName": "Earthquake Country",
      "queryLines": [
        "SELECT\r\n",
        "    COUNT(*) AS event_count,\r\n",
        "    CASE\r\n",
        "        WHEN size(split(place, ', ')) = 1 THEN split(place, ', ')[0]\r\n",
        "        ELSE split(place, ', ')[1]\r\n",
        "    END AS country\r\n",
        "FROM silver.earthquake_data_final\r\n",
        "GROUP BY\r\n",
        "    CASE\r\n",
        "        WHEN size(split(place, ', ')) = 1 THEN split(place, ', ')[0]\r\n",
        "        ELSE split(place, ', ')[1]\r\n",
        "    END;"
      ],
      "catalog": "dev_cat",
      "schema": "default"
    }
  ],
